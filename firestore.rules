rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // System persistence document for FinanFlow (persists accounts & state across cloud publishes)
    match /system/{systemId} {
      allow read, write: if isValidId(systemId);
    }

    // User profiles & data
    match /users/{userId} {
      allow read, write: if isValidId(userId);

      match /{subcollection=**} {
        allow read, write: if isValidId(userId);
      }
    }
  }
}
